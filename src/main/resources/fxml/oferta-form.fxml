<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-limpio" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.tracker.ui.OfertaFormController">
   <content>
      <VBox spacing="24.0" styleClass="contenido">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label fx:id="lblTitulo" styleClass="titulo-pagina" text="Nueva candidatura" />
                  <Label fx:id="lblSubtitulo" styleClass="subtitulo" text="Rellena los datos de la oferta" />
               </children>
            </VBox>
            <VBox spacing="16.0" styleClass="card">
               <children>
                  <GridPane hgap="16.0" vgap="14.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                     </columnConstraints>
                     <children>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Título *" />
                              <TextField fx:id="txtTitulo" promptText="Desarrollador Java Junior" />
                              <Label fx:id="errTitulo" styleClass="mensaje-error" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Empresa *" />
                              <ComboBox fx:id="cmbEmpresa" maxWidth="1.7976931348623157E308" promptText="Selecciona una empresa" />
                              <Label fx:id="errEmpresa" styleClass="mensaje-error" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Estado *" />
                              <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" />
                              <Label fx:id="errEstado" styleClass="mensaje-error" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Fecha de postulación *" />
                              <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" promptText="dd/MM/yyyy" />
                              <Label fx:id="errFecha" styleClass="mensaje-error" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Salario anual bruto (€)" />
                              <TextField fx:id="txtSalario" promptText="30000" />
                              <Label fx:id="errSalario" styleClass="mensaje-error" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Enlace a la oferta" />
                              <TextField fx:id="txtEnlace" promptText="https://…" />
                              <Label fx:id="errEnlace" styleClass="mensaje-error" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Descripción del puesto" />
                              <TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Notas" />
                              <TextArea fx:id="txtNotas" prefRowCount="3" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>
                  <Label fx:id="lblError" styleClass="mensaje-error" wrapText="true" />
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button cancelButton="true" mnemonicParsing="false" onAction="#cancelar" styleClass="btn-secundario" text="Cancelar" />
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primario" text="Guardar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
