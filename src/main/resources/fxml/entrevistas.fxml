<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24.0" styleClass="contenido" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.tracker.ui.EntrevistasController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-pagina" text="Entrevistas" />
                  <Label fx:id="lblResumen" styleClass="subtitulo" text="0 entrevistas registradas" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#nueva" styleClass="btn-primario" text="Nueva entrevista" />
         </children>
      </HBox>
      <HBox alignment="TOP_LEFT" spacing="24.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tabla" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colFecha" maxWidth="130.0" minWidth="100.0" prefWidth="110.0" text="Fecha" />
                  <TableColumn fx:id="colOferta" prefWidth="240.0" text="Candidatura" />
                  <TableColumn fx:id="colEmpresa" prefWidth="130.0" text="Empresa" />
                  <TableColumn fx:id="colTipo" prefWidth="110.0" text="Tipo" />
                  <TableColumn fx:id="colResultado" prefWidth="110.0" text="Resultado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <VBox maxHeight="-Infinity" prefWidth="380.0" spacing="14.0" styleClass="card">
               <children>
                  <Label fx:id="lblFormulario" styleClass="titulo-tarjeta" text="Programar entrevista" />
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Candidatura *" />
                        <ComboBox fx:id="cmbOferta" maxWidth="1.7976931348623157E308" promptText="Selecciona una candidatura" />
                        <Label fx:id="errOferta" styleClass="mensaje-error" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Fecha *" />
                        <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" promptText="dd/MM/yyyy" />
                        <Label fx:id="errFecha" styleClass="mensaje-error" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Tipo *" />
                        <ComboBox fx:id="cmbTipo" maxWidth="1.7976931348623157E308" promptText="Selecciona el tipo" />
                        <Label fx:id="errTipo" styleClass="mensaje-error" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Resultado" />
                        <ComboBox fx:id="cmbResultado" maxWidth="1.7976931348623157E308" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Notas" />
                        <TextArea fx:id="txtNotas" prefRowCount="3" wrapText="true" />
                     </children>
                  </VBox>
                  <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" />
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-peligro" text="Eliminar" />
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primario" text="Guardar entrevista" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
