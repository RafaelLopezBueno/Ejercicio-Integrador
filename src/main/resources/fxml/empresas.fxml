<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24.0" styleClass="contenido" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.tracker.ui.EmpresasController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="titulo-pagina" text="Empresas" />
                  <Label fx:id="lblResumen" styleClass="subtitulo" text="0 empresas registradas" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#nueva" styleClass="btn-primario" text="Nueva empresa" />
         </children>
      </HBox>
      <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="colSector" prefWidth="240.0" text="Sector" />
            <TableColumn fx:id="colWeb" prefWidth="240.0" text="Web" />
            <TableColumn fx:id="colRegistro" prefWidth="120.0" text="Registro" />
            <TableColumn fx:id="colOfertas" prefWidth="120.0" text="Candidaturas" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editar" styleClass="btn-secundario" text="Editar" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-peligro" text="Eliminar" />
         </children>
      </HBox>
   </children>
</VBox>
